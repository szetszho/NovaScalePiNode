 const HANDSHAKE_ENV = 'BLE_RMSC04_HANDSHAKE';
 
+// ─── Local patch (Scale Hub): the scale computes for whoever stepped on ──────
+//
+// Scale Hub writes household.json (next to config.yaml, or BLE_RMSC04_HOUSEHOLD):
+//   {"enabled": true, "people": [{"slug", "height_cm", "byte", "weight"}]}
+// When the weight settles (0x24), the person whose reference weight is nearest gets their
+// b2 written (guest slot 09, their height and profile byte) before the scale starts its body
+// scan (status 0x09, about 6 s later), so the 0x25 record is computed for them. The record's
+// raw figures go out in the payload as `rmsc04`; Scale Hub checks the record's BMI against
+// the height sent before it trusts them. No file, or enabled false: nothing changes.
+const HOUSEHOLD_ENV = 'BLE_RMSC04_HOUSEHOLD';
+const HOUSEHOLD_FILE = 'household.json';
+const HOUSEHOLD_SEQ = 2;
+
+interface HouseholdPerson {
+  slug: string;
+  heightTenths: number;
+  byte: number;
+  weight: number;
+}
+
+function readHousehold(): HouseholdPerson[] {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(readFileSync(process.env[HOUSEHOLD_ENV] || HOUSEHOLD_FILE, 'utf8'));
+  } catch {
+    return [];
+  }
+  const doc = raw as { enabled?: unknown; people?: unknown } | null;
+  if (!doc || doc.enabled !== true || !Array.isArray(doc.people)) return [];
+  const out: HouseholdPerson[] = [];
+  for (const item of doc.people as Record<string, unknown>[]) {
+    const h = Number(item?.height_cm);
+    const b = Number(item?.byte);
+    const w = Number(item?.weight);
+    if (typeof item?.slug !== 'string' || !(h >= 50 && h <= 250)) continue;
+    if (!Number.isInteger(b) || b < 0 || b > 0xff || !(w > 0 && w <= 300)) continue;
+    out.push({ slug: item.slug, heightTenths: Math.round(h * 10), byte: b, weight: w });
+  }
+  return out;
+}
+
+/** Nearest reference weight within max(3 kg, 5 %), and at least 1 kg clearer than the next. */
+export function matchHousehold(people: HouseholdPerson[], weight: number): HouseholdPerson | null {
+  const ranked = people
+    .map((p) => ({ p, d: Math.abs(weight - p.weight) }))
+    .sort((a, b) => a.d - b.d);
+  const best = ranked[0];
+  if (!best || best.d > Math.max(3, 0.05 * best.p.weight)) return null;
+  if (ranked[1] && ranked[1].d - best.d < 1) return null;
+  return best.p;
+}
